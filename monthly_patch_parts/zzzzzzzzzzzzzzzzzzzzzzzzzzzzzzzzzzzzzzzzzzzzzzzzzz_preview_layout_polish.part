
/* SWSI Preview Layout Polish 2026-08-29
   Visual-review-only refinements after the learning-center simplification.
   Home vertical spacing is owned by 50.home-spacing-essay-entry.part.
   This layer only keeps the mobile tabbar flush and loading-state attribution lower.
*/
(function(){
  'use strict';

  var STYLE_ID='swsi-preview-layout-polish-20260829';
  if(!document.getElementById(STYLE_ID)){
    var st=document.createElement('style');
    st.id=STYLE_ID;
    st.textContent=`
      @media(max-width:720px){
        /* Native-style dock: full width, flush to the viewport edge, no floating
           rounded card / detached shadow. */
        .tabbar{
          left:0!important;
          right:0!important;
          bottom:0!important;
          width:100%!important;
          max-width:none!important;
          transform:none!important;
          border-radius:0!important;
          box-shadow:none!important;
          border-left:0!important;
          border-right:0!important;
          border-bottom:0!important;
          border-top:1px solid var(--line)!important;
          background:rgba(248,250,249,.985)!important;
          padding-left:env(safe-area-inset-left,0px)!important;
          padding-right:env(safe-area-inset-right,0px)!important;
        }
      }

      /* Active question pages are study surfaces, not public-information pages.
         Keep the footer out of the answer flow; it returns automatically after
         leaving the question card. */
      body.swsi-question-active .wrap>footer,
      body.swsi-question-active footer{
        display:none!important;
      }

      /* Closed disclosures should consume only their summary row. */
      #app details.swsi-other-tools:not([open]),
      #app details.swsi-data-version:not([open]){
        padding-bottom:0!important;
      }
      #app details.swsi-other-tools:not([open]) .swsi-other-grid,
      #app details.swsi-data-version:not([open]) .body{
        display:none!important;
      }
      #app .swsi-principle-note{margin-bottom:0!important;}
      #app .swsi-data-version{margin-bottom:0!important;}

      /* Only the bank-preparation screen gets deliberate vertical separation.
         This keeps attribution/info visually below the loading message without
         changing normal home spacing. */
      body.swsi-bank-preparing .wrap>footer,
      body.swsi-bank-preparing footer{
        margin-top:clamp(150px,22dvh,260px)!important;
      }
      @supports not (height:1dvh){
        body.swsi-bank-preparing .wrap>footer,
        body.swsi-bank-preparing footer{margin-top:clamp(150px,22vh,260px)!important;}
      }
    `;
    document.head.appendChild(st);
  }

  function syncPreparingState(){
    var app=document.getElementById('app');
    var text=app?(app.textContent||''):'';
    var preparing=/載入題庫|準備完整題庫|第一次開啟全庫功能|下載已發布的歷屆考次/.test(text);
    var questionActive=!!(app&&app.querySelector('.qcard'));
    document.body.classList.toggle('swsi-bank-preparing',preparing);
    document.body.classList.toggle('swsi-question-active',questionActive);
  }

  syncPreparingState();
  var app=document.getElementById('app');
  if(app){
    try{
      var queued=false;
      var mo=new MutationObserver(function(){
        if(queued)return;
        queued=true;
        requestAnimationFrame(function(){queued=false;syncPreparingState();});
      });
      mo.observe(app,{childList:true,subtree:true,characterData:true});
    }catch(_e){}
  }
  window.addEventListener('pageshow',syncPreparingState);
})();
