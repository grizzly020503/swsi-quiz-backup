
/* SWSI Feedback Safari AutoFill Guard 2026-08-29
   Safari intentionally ignores autocomplete="off" in some AutoFill flows.
   The legacy client-side honeypot could therefore be populated for a real
   iPhone/Safari user and silently abort feedback before any network request.

   Keep the existing submit transport and server protections unchanged. This
   guard only prevents browser AutoFill from turning the hidden field into a
   false-positive bot signal. Server-side origin validation, payload limits,
   anonymous client hashing, and DB rate limits remain authoritative.
*/
(function(){
  'use strict';

  var baseOpen=window.swsiOpenReport;
  if(typeof baseOpen!=='function')return;
  if(baseOpen.__swsiSafariHoneypotGuard==='2026-08-29')return;

  function protectHoneypot(){
    var form=document.getElementById('swsi-report-form');
    var hp=document.getElementById('swsi-report-website');
    if(!form||!hp)return;

    /* Do not let contact/password managers retain a false-positive value. */
    try{
      hp.value='';
      hp.readOnly=true;
      hp.setAttribute('autocomplete','new-password');
      hp.setAttribute('data-lpignore','true');
      hp.setAttribute('data-1p-ignore','true');
    }catch(_e){}

    if(form.dataset.swsiHoneypotGuard==='1')return;
    form.dataset.swsiHoneypotGuard='1';

    /* Capture runs before the original bubble-phase submitReport listener. */
    form.addEventListener('submit',function(){
      try{hp.value='';}catch(_e){}
    },true);
  }

  function guardedOpen(){
    var result=baseOpen.apply(this,arguments);
    protectHoneypot();
    return result;
  }

  guardedOpen.__swsiSafariHoneypotGuard='2026-08-29';
  guardedOpen.__swsiBaseOpen=baseOpen;
  window.swsiOpenReport=guardedOpen;
  window.SWSI_FEEDBACK_SAFARI_GUARD={version:'2026-08-29'};
})();
