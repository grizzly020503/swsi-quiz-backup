/* ===== SWSI AI Quota Message Contract 2026-08-26 ===== */
(function(){
  'use strict';

  function H(v){
    if(typeof window.swsiEsc==='function')return window.swsiEsc(v);
    return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
  }

  async function quotaAwareCall(fn,args,id){
    var baseFetch=window.swsiFetchWithTimeout;
    if(typeof baseFetch!=='function')return fn.apply(window,args);
    var quotaMessage='';
    var quotaCode='';

    var wrappedFetch=async function(url,options,ms){
      var response=await baseFetch(url,options,ms);
      if(response&&response.status===429){
        try{
          var data=await response.clone().json();
          quotaMessage=String(data&&data.error&&data.error.message||'').trim();
          quotaCode=String(data&&data.error&&data.error.code||'').trim();
        }catch(_e){}
      }
      return response;
    };

    window.swsiFetchWithTimeout=wrappedFetch;
    try{
      return await fn.apply(window,args);
    }finally{
      if(window.swsiFetchWithTimeout===wrappedFetch)window.swsiFetchWithTimeout=baseFetch;
      if(quotaMessage){
        var out=document.getElementById('airesult_'+id);
        if(out){
          var prefix=(quotaCode==='CLIENT_DAILY_QUOTA'||quotaCode==='GLOBAL_DAILY_QUOTA')?'今日額度提醒':'AI 使用提醒';
          out.innerHTML='<div style="margin-top:12px;font-size:13px;color:var(--wrong);line-height:1.7"><b>'+H(prefix)+'：</b>'+H(quotaMessage)+'</div>';
        }
      }
    }
  }

  if(typeof window.runAIFeedback==='function'){
    var previousTextFeedback=window.runAIFeedback;
    window.runAIFeedback=function(id){return quotaAwareCall(previousTextFeedback,[id],id);};
    try{runAIFeedback=window.runAIFeedback;}catch(_e){}
  }

  if(typeof window.gradePhoto==='function'){
    var previousPhotoFeedback=window.gradePhoto;
    window.gradePhoto=function(id,input){return quotaAwareCall(previousPhotoFeedback,[id,input],id);};
    try{gradePhoto=window.gradePhoto;}catch(_e){}
  }

  window.swsiAIQuotaMessageVersion='2026-08-26.server-message.v1';
})();
/* ===== SWSI AI Quota Message Contract END ===== */
