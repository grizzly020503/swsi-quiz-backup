/* ===== SWSI Final Runtime Contract 2026-08-26 ===== */
(function(){
  'use strict';

  /* Keep the mock-exam record policy explicit and testable. all_credit is a
     score rule, not an answered choice, so an unanswered all-credit row must
     not be written into the learner's wrong-answer history. */
  window.swsiShouldRecordMockAnswer=function(gm,picked){
    if(gm==='all_credit'&&picked==null)return false;
    return true;
  };

  /* The repository still contains older home implementations. This last layer
     guarantees that the actual DOM contract stores only all/1/2 while keeping
     第一次／第二次 as presentation labels. */
  if(typeof renderHome==='function'){
    var previousRenderHome=renderHome;
    renderHome = function(){
      var result=previousRenderHome.apply(this,arguments);
      try{
        var select=document.querySelector('#app select[aria-label="考試考次"]');
        if(select){
          var current='all';
          try{current=homeQuizRound==='all'?'all':canonicalRound(homeQuizRound);}catch(_e){}
          select.innerHTML=
            '<option value="all">全部考次</option>'+
            '<option value="1">第一次</option>'+
            '<option value="2">第二次</option>';
          select.value=(current==='1'||current==='2')?current:'all';
          try{homeQuizRound=select.value;}catch(_e){}
        }
      }catch(err){console.warn('[SWSI] final round selector normalization skipped',err);}
      return result;
    };
  }

  window.swsiFinalRuntimeContractVersion='2026-08-26.v1';
})();
/* ===== SWSI Final Runtime Contract END ===== */
