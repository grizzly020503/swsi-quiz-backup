/* SWSI Question Trust Metadata Passthrough 2026-10-03
   Data-transport owner only. The student trust UI remains owned by
   zzzz_product_v1_lock.part.

   Problem fixed here:
   - official question metadata existed in CDN shards, but normalize/offline
     compatibility paths could drop source_url and analysis_status;
   - the trust panel then misclassified an official historical question as
     SWSI-only content and displayed an unknown analysis state.
*/
(function(){
  'use strict';

  var TRUST_FIELDS=[
    'source_exam_code','source_url','analysis_status',
    'legal_status','legal_checked_at','legal_note','legal_source_url'
  ];

  function copyTrustMetadata(target,source){
    if(!target||!source)return target;
    TRUST_FIELDS.forEach(function(key){
      if(Object.prototype.hasOwnProperty.call(source,key)&&source[key]!==undefined){
        target[key]=source[key];
      }
    });
    return target;
  }

  /* The 00.part normalizer owns grading and core shape. This wrapper only
     preserves trust/source metadata already supplied by the verified shard or
     scoped Supabase fallback. It never invents source provenance. */
  if(typeof normalize==='function'){
    var previousNormalize=normalize;
    normalize=function(r){
      return copyTrustMetadata(previousNormalize(r),r);
    };
  }

  /* Legacy full-cache compatibility serializes a reduced row shape. Before it
     is written, restore trust metadata from the already-normalized in-memory
     question. This also repairs future cache writes on devices that previously
     stored rows without source_url / analysis_status. */
  if(typeof saveOfflineQuestions==='function'){
    var previousSaveOfflineQuestions=saveOfflineQuestions;
    saveOfflineQuestions=function(rows){
      if(!Array.isArray(rows))return previousSaveOfflineQuestions(rows);
      var byId=new Map();
      try{
        if(Array.isArray(ALL)){
          ALL.forEach(function(item){
            if(item&&item.id)byId.set(String(item.id),item);
          });
        }
      }catch(_e){}
      var enriched=rows.map(function(row){
        var out=Object.assign({},row||{});
        var current=byId.get(String(out.id||''));
        if(current)copyTrustMetadata(out,current);
        return out;
      });
      return previousSaveOfflineQuestions(enriched);
    };
  }

  /* Expose the field list for diagnostics/contracts, not as an authority flag. */
  window.SWSI_QUESTION_TRUST_METADATA_FIELDS=TRUST_FIELDS.slice();
})();
