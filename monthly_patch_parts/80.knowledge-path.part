
/* SWSI Knowledge Path V1 2026-08-26
   One query -> understand -> see exam patterns -> practice.
   Keeps theory/law summaries distinct from official exam questions.
*/
(function(){
  'use strict';

  var STYLE_ID='swsi-knowledge-path-v1-style';
  if(!document.getElementById(STYLE_ID)){
    var st=document.createElement('style');
    st.id=STYLE_ID;
    st.textContent=`
      .swsi-k-search-shell{padding-top:4px}
      .swsi-k-searchbox{width:100%;box-sizing:border-box;font-family:'Noto Sans TC',sans-serif;font-size:16px;padding:13px 15px;border:1px solid #D6E0DB;border-radius:12px;background:#fff;color:var(--ink);outline:none}
      .swsi-k-searchbox:focus{border-color:var(--pine);box-shadow:0 0 0 2px rgba(79,126,118,.07)}
      .swsi-k-empty{padding:20px 2px 2px;color:var(--ink-soft);font-family:'Noto Sans TC',sans-serif;font-size:var(--fs-s);line-height:1.8}
      .swsi-k-examples{display:flex;flex-wrap:wrap;gap:7px;margin-top:13px}
      .swsi-k-examples button{border:1px solid #D8E1DC;background:#fff;color:var(--pine-deep);border-radius:999px;padding:7px 10px;font-family:'Noto Sans TC',sans-serif;font-size:12px;font-weight:700;cursor:pointer}

      .swsi-k-path{margin:17px 0 2px;background:transparent;border:0;border-top:1px solid #E1E7E3;border-bottom:1px solid #E1E7E3;border-radius:0;padding:16px 2px}
      .swsi-k-path b{display:block;font-family:'Noto Serif TC',serif;font-size:17px;color:#202724;line-height:1.5}
      .swsi-k-path span{display:block;font-family:'Noto Sans TC',sans-serif;font-size:12px;color:#626D67;line-height:1.7;margin-top:4px}
      .swsi-k-counts{display:flex;flex-wrap:wrap;gap:12px;margin-top:11px}
      .swsi-k-counts i{font-style:normal;background:transparent;border:0;border-radius:0;padding:0;font-family:'Noto Sans TC',sans-serif;font-size:11px;font-weight:700;color:#5C6862}

      .swsi-k-sec{margin-top:25px;border-top:1px solid #E2E7E4;padding-top:16px}
      .swsi-k-sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:5px}
      .swsi-k-sec-h b{font-family:'Noto Serif TC',serif;font-size:15.5px;color:var(--ink)}
      .swsi-k-sec-h span{font-family:'Noto Sans TC',sans-serif;font-size:11.5px;color:#69736E}
      .swsi-k-card{width:100%;display:block;text-align:left;border:0;border-bottom:1px solid #E5E9E6;border-radius:0;padding:14px 2px;margin:0;background:transparent;color:var(--ink);font-family:inherit;cursor:pointer}
      .swsi-k-card:hover{background:#FAFBFA}
      .swsi-k-card .type{font-family:'Noto Sans TC',sans-serif;font-size:10.5px;font-weight:800;letter-spacing:.05em;color:var(--pine);margin-bottom:4px}
      .swsi-k-card.law .type{color:#756E57}
      .swsi-k-card .name{font-family:'Noto Serif TC',serif;font-size:14.5px;font-weight:800;line-height:1.5}
      .swsi-k-card .desc{font-family:'Noto Sans TC',sans-serif;font-size:12px;color:#68726D;line-height:1.7;margin-top:4px}
      .swsi-k-question{border:0;border-bottom:1px solid #E5E9E6;border-radius:0;padding:13px 2px;margin:0;background:transparent;cursor:pointer}
      .swsi-k-question:hover{background:#FAFBFA}
      .swsi-k-question .q{font-size:13.5px;line-height:1.68;color:var(--ink)}
      .swsi-k-question .meta{font-family:'Noto Sans TC',sans-serif;font-size:11px;color:#69736E;line-height:1.55;margin-top:5px}
      .swsi-k-hl{background:var(--brand-soft,#F6ECE5);color:var(--brand-deep,#8A4122);font-weight:700;border-radius:3px;padding:0 1px}
      .swsi-k-question .hit{font-family:'Noto Sans TC',sans-serif;font-size:12.5px;line-height:1.6;color:var(--ink-soft);margin-top:5px}
      .swsi-k-question .hit span{display:inline-block;margin-right:6px;font-weight:700;color:var(--ink)}
      .swsi-k-partial{font-family:'Noto Sans TC',sans-serif;font-size:12.5px;line-height:1.7;color:var(--ink-soft);background:var(--fill,#EFEBE3);border-radius:10px;padding:10px 12px;margin:0 0 10px}
      .swsi-k-more{font-family:'Noto Sans TC',sans-serif;font-size:11.5px;color:var(--ink-soft);margin:9px 2px 4px}
      .swsi-k-muted{border:0;border-top:1px solid #E5E9E6;border-bottom:1px solid #E5E9E6;border-radius:0;padding:12px 2px;font-family:'Noto Sans TC',sans-serif;font-size:12px;line-height:1.7;color:#68726D;background:transparent}
      .swsi-k-action{width:100%;min-height:44px;border:none;border-radius:11px;background:var(--pine-deep);color:#fff;font-family:'Noto Sans TC',sans-serif;font-size:13px;font-weight:800;cursor:pointer;margin:8px 0 7px}
      .swsi-k-action.ghost{border:1px solid #CED9D3;background:transparent;color:var(--pine-deep)}

      .swsi-k-net{margin-top:18px;padding-top:16px;border-top:1px solid #E1E7E3}
      .swsi-k-net-title{font-family:'Noto Serif TC',serif;font-size:14.5px;font-weight:800;color:var(--pine-deep);margin-bottom:10px}
      .swsi-k-related-label{font-family:'Noto Sans TC',sans-serif;font-size:11.5px;font-weight:800;color:#66716B;margin:13px 0 7px}
      .swsi-k-related{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:9px}
      .swsi-k-related button{border:1px solid #D7E0DB;background:#fff;border-radius:999px;padding:6px 9px;color:var(--pine-deep);font-family:'Noto Sans TC',sans-serif;font-size:11.5px;font-weight:700;cursor:pointer}
      .swsi-k-net .swsi-k-question{background:transparent}
      .swsi-k-search-all{width:100%;min-height:42px;border:1px solid #CAD8D1;border-radius:10px;background:transparent;color:var(--pine-deep);font-family:'Noto Sans TC',sans-serif;font-size:12.5px;font-weight:800;cursor:pointer;margin-bottom:8px}


      /* In-context learning links stay collapsed until the student asks for more. */
      .swsi-related-learning{margin:12px 0;border:1px solid #DCE6E0;border-radius:12px;background:#FAFCFA;color:var(--ink);overflow:hidden}
      .swsi-related-learning>summary{cursor:pointer;list-style-position:inside;padding:11px 12px;font:750 12.5px/1.65 'Noto Sans TC',sans-serif;color:var(--pine-deep)}
      .swsi-related-learning .swsi-related-body{border-top:1px solid #E1E9E3;padding:11px 12px;display:grid;gap:7px}
      .swsi-related-learning .swsi-related-note{font:400 11px/1.6 'Noto Sans TC',sans-serif;color:var(--ink-soft);margin:2px 0}
      .swsi-related-learning button{display:block;width:100%;min-height:40px;border:1px solid #DFE8E2;border-radius:9px;background:#fff;padding:9px 11px;text-align:left;color:var(--pine-deep);font:700 12.5px/1.55 'Noto Sans TC',sans-serif;cursor:pointer}
      .swsi-related-learning button:hover{border-color:#9ABAAF;background:#F7FAF8}
      .swsi-related-learning button:focus-visible{outline:2px solid var(--pine-deep);outline-offset:2px}
      .swsi-k-pagelead{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:4px 0 12px;border-bottom:1px solid #E5E9E6;padding-bottom:7px}
      .swsi-k-pagelead button{border:none;background:none;color:var(--pine-deep);font-family:'Noto Sans TC',sans-serif;font-size:12px;font-weight:700;cursor:pointer;padding:5px 0}
      /* 2026-11-22 system (簡單大字): system font, readable sizes, warm tokens. */
      .swsi-k-searchbox{font-family:var(--swsi-font);font-size:max(16px,calc(var(--fs-b) - 1px));min-height:52px;border:1px solid var(--line);border-radius:var(--r-md);background:var(--paper2)}
      .swsi-k-searchbox:focus{border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft)}
      .swsi-k-empty{font-family:var(--swsi-font);font-size:var(--fs-b)}
      .swsi-k-examples button,.swsi-k-related button{min-height:40px;border:0;background:var(--brand-soft);color:var(--brand-deep);padding:8px 14px;font-family:var(--swsi-font);font-size:15px;font-weight:500}
      .swsi-k-path{border:0;border-radius:var(--r-lg);background:var(--paper2);padding:18px 20px}
      .swsi-k-path b,.swsi-k-sec-h b,.swsi-k-card .name,.swsi-k-net-title{font-family:var(--swsi-font);color:var(--ink)}
      .swsi-k-path b{font-size:var(--fs-h);font-weight:700}
      .swsi-k-path span,.swsi-k-card .desc,.swsi-k-muted,.swsi-k-more{font-family:var(--swsi-font);font-size:var(--fs-s);color:var(--ink-3)}
      .swsi-k-counts i,.swsi-k-sec-h span,.swsi-k-question .meta,.swsi-k-related-label{font-family:var(--swsi-font);font-size:14px;color:var(--ink-3)}
      .swsi-k-sec{border-top:0}
      .swsi-k-sec-h b{font-size:var(--fs-h);font-weight:700}
      .swsi-k-card{border-bottom:1px solid var(--line);padding:16px 2px;font-family:var(--swsi-font)}
      .swsi-k-card .type{font-family:var(--swsi-font);font-size:14px;font-weight:600;letter-spacing:0;color:var(--brand)}
      .swsi-k-card.law .type{color:var(--ink-3)}
      .swsi-k-card .name{font-size:var(--fs-b);font-weight:600}
      .swsi-k-card:hover,.swsi-k-question:hover{background:transparent}
      .swsi-k-question{border-bottom:1px solid var(--line);padding:16px 2px}
      .swsi-k-question .q{font-size:var(--fs-b)}
      .swsi-k-question .hit,.swsi-k-partial{font-family:var(--swsi-font);font-size:var(--fs-s);color:var(--ink-soft)}
      .swsi-k-partial{background:var(--fill);border-radius:var(--r-md)}
      .swsi-k-action{min-height:52px;border-radius:var(--r-md);background:var(--brand);font-family:var(--swsi-font);font-size:17px;font-weight:600}
      .swsi-k-action.ghost{border:0;background:var(--brand-soft);color:var(--brand-deep)}
      .swsi-k-net{border-top:1px solid var(--line)}
      .swsi-k-net-title{font-size:18px;font-weight:700}
      .swsi-k-search-all{min-height:48px;border:0;border-radius:var(--r-md);background:var(--brand-soft);color:var(--brand-deep);font-family:var(--swsi-font);font-size:16px;font-weight:600}
      .swsi-related-learning{border:0;border-radius:var(--r-lg);background:var(--paper2)}
      .swsi-related-learning>summary{min-height:52px;padding:14px 16px;font:600 16px/1.5 var(--swsi-font);color:var(--brand-deep)}
      .swsi-related-learning .swsi-related-body{border-top:1px solid var(--line);padding:12px 16px}
      .swsi-related-learning .swsi-related-note{font:400 14px/1.6 var(--swsi-font)}
      .swsi-related-learning button{min-height:48px;border:0;border-radius:var(--r-sm);background:var(--paper);padding:10px 14px;color:var(--ink);font:500 16px/1.5 var(--swsi-font)}
      .swsi-related-learning button:hover{border-color:transparent;background:var(--fill)}
      .swsi-related-learning button:focus-visible{outline:3px solid var(--brand)}
      .swsi-k-pagelead{border-bottom:0;margin:0 0 16px;padding:0}
      .swsi-k-pagelead button{min-height:44px;padding:0;color:var(--brand);font-family:var(--swsi-font);font-size:calc(var(--fs-b) - 1px);font-weight:500}
      @media(max-width:370px){.swsi-k-sec-h{display:block}.swsi-k-sec-h span{display:block;margin-top:2px}.swsi-k-counts{gap:9px}}
    `;
    document.head.appendChild(st);
  }

  function H(v){
    return String(v==null?'':v).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
  }
  function E(v){return encodeURIComponent(String(v==null?'':v)).replace(/'/g,'%27');}
  function N(v){return String(v==null?'':v).toLowerCase().replace(/[\s　（）()《》〈〉「」『』【】·・,，.。:：;；/\\_-]+/g,'');}
  function A(v){return Array.isArray(v)?v:(v?String(v).split(/[、,，;；]/).filter(Boolean):[]);}
  function sn(v,n){var s=String(v||'').replace(/\s+/g,' ').trim();return s.length>n?s.slice(0,n)+'…':s;}
  function yearNum(v){var n=parseInt(String(v||'').replace(/\D/g,''),10);return Number.isFinite(n)?n:0;}
  function uniqPush(arr,item,key){var k=key(item);if(!arr.some(function(x){return key(x)===k;}))arr.push(item);}

  var ALIASES={
    '充權':['增強權能','賦權'],
    '增強權能':['充權','賦權'],
    '賦權':['充權','增強權能'],
    '艾瑞克森':['Erikson'],
    'erikson':['艾瑞克森'],
    '依附':['Bowlby','Ainsworth'],
    '生態系統':['生態系統理論','生態觀點']
  };

  // ===== Question search engine (2026-11-24) =====
  // Students search like a search engine: by any remembered phrase (stem,
  // topic, keyword, law or an option), sometimes in simplified Chinese, and
  // expect the best match first with the matched words visible.
  var S2T_PAIRS='万萬与與丑醜专專业業丛叢东東丝絲丢丟两兩严嚴丧喪个個丰豐临臨为為丽麗举舉么麼义義乌烏乐樂乔喬习習乡鄉书書买買乱亂争爭于於亏虧云雲亚亞产產亲親亵褻亿億仅僅仆僕从從仓倉仪儀们們价價众眾优優伙夥会會伟偉传傳伤傷伦倫伪偽体體余餘侣侶侥僥侦偵侧側侨僑侪儕俭儉债債倾傾偿償储儲儿兒党黨兰蘭关關兴興兹茲养養内內册冊写寫军軍农農冲衝决決况況冻凍准準凉涼减減几幾凤鳳凭憑凯凱凶兇击擊划劃则則刚剛创創删刪别別制製刹剎剀剴剂劑剥剝剧劇劝勸办辦务務动動励勵劳勞势勢匮匱区區医醫升昇华華协協单單卖賣卫衛却卻卷捲厂廠厅廳历歷厉厲压壓厌厭厕廁厘釐厦廈县縣参參双雙发發变變叙敘叠疊只隻台臺叶葉号號叹嘆吁籲后後向嚮吓嚇吗嗎听聽启啟吴吳员員周週咨諮咽嚥响響哔嗶唠嘮唤喚喂餵嘘噓嘱囑回迴团團园園围圍国國图圖圆圓圣聖场場坏壞坚堅坛壇坝壩坠墜垄壟堕墮墙牆壮壯声聲壳殼处處备備复復够夠头頭夸誇夹夾夺奪奋奮奖獎奸姦妆妝妇婦妈媽娇嬌娱娛婴嬰嬷嬤孙孫学學宁寧宝寶实實宠寵审審宪憲宫宮宽寬宾賓对對寻尋导導寿壽将將尔爾尘塵尝嘗尧堯尴尷尽儘局侷层層届屆属屬岁歲崭嶄巨鉅巩鞏币幣布佈师師帐帳带帶帮幫干幹并並幸倖广廣库庫应應庙廟庞龐废廢开開异異弃棄张張弥彌弹彈强強归歸当當录錄征徵径徑御禦忆憶志誌忧憂念唸怀懷态態怜憐总總恋戀恒恆恤卹恳懇恶惡恸慟恼惱悦悅悬懸惊驚惧懼惩懲惫憊惯慣愈癒愤憤愿願懒懶戏戲战戰户戶扎紮扑撲托託执執扩擴扬揚扰擾抚撫抛拋抢搶护護报報担擔拟擬拥擁拨撥择擇挛攣挡擋挣掙挤擠挥揮损損换換据據掴摑搁擱搜蒐携攜摄攝摆擺摇搖摊攤撑撐撷擷敌敵敛斂数數斗鬥断斷无無旧舊时時显顯晋晉晒曬晓曉晕暈晖暉暂暫暧曖术術朴樸机機杀殺杂雜权權条條来來杰傑松鬆板闆极極构構枪槍柜櫃标標栏欄树樹栖棲栗慄样樣档檔桦樺梦夢检檢棱稜楼樓槛檻槟檳横橫橥櫫欢歡欧歐欲慾残殘殓殮殡殯殴毆毁毀毕畢气氣汇彙汉漢汤湯汹洶沟溝没沒泄洩泛氾泞濘注註泼潑洁潔浅淺测測济濟浏瀏浓濃涂塗涌湧涛濤润潤涨漲渊淵渎瀆渐漸渗滲温溫游遊湾灣溃潰滚滾滞滯满滿滤濾滥濫潜潛灭滅灯燈灵靈灾災炉爐点點烟菸烦煩烧燒烫燙热熱爱愛爷爺牵牽牺犧状狀犹猶独獨狱獄献獻玛瑪环環现現琐瑣电電画畫畅暢畴疇疗療疡瘍疯瘋痉痙痒癢痪瘓瘫癱瘾癮癫癲监監盖蓋盗盜盘盤瞒瞞矫矯矿礦码碼础礎硕碩确確碍礙碱鹼礼禮祸禍离離种種积積称稱税稅稳穩穷窮窃竊窝窩窥窺窦竇竞競笔筆笼籠筑築筛篩筹籌签籤简簡篱籬类類粮糧系係紧緊纠糾红紅纤纖约約级級纪紀纯純纲綱纳納纵縱纷紛纸紙纹紋纽紐纾紓线線练練组組细細织織终終绊絆绍紹绎繹经經绑綁结結绕繞绘繪给給络絡绝絕统統绣繡继繼绩績绪緒续續绳繩维維综綜绿綠缉緝缓緩缔締编編缘緣缚縛缜縝缝縫缩縮缮繕缴繳网網罗羅罚罰羁羈羡羨翘翹耻恥聂聶职職联聯聪聰肠腸肤膚肮骯肾腎肿腫胀脹胁脅胆膽胜勝胶膠脉脈脏臟脑腦脚腳脱脫脸臉腊臘腻膩致緻舍捨艰艱艺藝节節苏甦苹蘋范範茎莖茧繭荐薦荡盪荣榮药藥莱萊莲蓮获獲萤螢营營萧蕭蓝藍蕴蘊虑慮虚虛虽雖蚀蝕蜕蛻蝉蟬衅釁衔銜补補袭襲装裝裤褲见見观觀规規觅覓视視览覽觉覺觞觴触觸誉譽誊謄计計订訂认認讨討让讓训訓议議讯訊记記讲講许許论論讼訟讽諷设設访訪证證评評识識诈詐诉訴诊診词詞译譯试試诘詰诚誠话話诞誕诠詮询詢该該详詳诫誡语語误誤诱誘说說诵誦请請诸諸诺諾读讀诽誹课課谁誰调調谅諒谈談谊誼谋謀谎謊谐諧谑謔谓謂谙諳谢謝谣謠谤謗谦謙谨謹谬謬谱譜谴譴谵譫谷穀贝貝负負贡貢财財责責贤賢败敗货貨质質贩販贪貪贫貧贬貶购購贯貫贱賤贴貼贵貴贷貸贸貿费費贺賀贿賄赂賂赃贓资資赈賑赋賦赌賭赎贖赏賞赔賠赖賴赚賺赛賽赞贊赠贈赢贏赶趕趋趨跃躍践踐跷蹺踊踴踌躊踪蹤车車轨軌轩軒转轉轮輪软軟轴軸轻輕载載轾輊较較辅輔辈輩辍輟辑輯输輸辖轄辗輾辞辭辟闢辩辯边邊达達迁遷过過迈邁运運还還这這进進远遠违違连連迟遲迳逕迹跡适適选選逊遜递遞逻邏遗遺邮郵邻鄰郁鬱采採释釋里裡鉴鑑针針钉釘钙鈣钟鐘钥鑰钦欽钩鉤钮鈕钱錢钻鑽铁鐵铨銓银銀铸鑄铺鋪链鏈销銷锁鎖锋鋒锐銳错錯键鍵锯鋸锾鍰镇鎮镖鏢镜鏡镳鑣长長门門闭閉问問闲閒间間闷悶闹鬧闻聞阅閱阈閾阉閹阐闡阔闊队隊阳陽阴陰阵陣阶階际際陆陸陈陳险險随隨隐隱隶隸难難雇僱雏雛雾霧静靜面麵韦韋韧韌韩韓页頁顶頂项項顺順须須顾顧顿頓颁頒预預领領颇頗颈頸颊頰频頻颗顆题題颜顏额額颞顳颠顛颤顫风風飞飛饥飢饪飪饭飯饮飲饰飾饱飽饼餅饿餓馆館馈饋马馬驭馭驰馳驱驅驳駁驶駛驻駐驾駕骂罵骄驕验驗骑騎骗騙骚騷骤驟鲁魯鲜鮮鸟鳥鸣鳴鸦鴉鸿鴻鹃鵑鹰鷹麦麥黄黃齐齊齿齒龄齡龙龍';
  var S2T={};for(var si=0;si+1<S2T_PAIRS.length;si+=2)S2T[S2T_PAIRS.charAt(si)]=S2T_PAIRS.charAt(si+1);
  function toTrad(v){return String(v==null?'':v).replace(/[一-鿿]/g,function(c){return S2T[c]||c;});}
  function queryTerms(q){var out=[];toTrad(q).trim().split(/\s+/).forEach(function(w){var n=N(w);if(n&&out.indexOf(n)<0)out.push(n);});return out;}
  var MCQ_FIELDS=[['q',10,''],['topic',8,'考點'],['keywords',6,'關鍵字'],['law',6,'法規'],['A',4,'選項 A'],['B',4,'選項 B'],['C',4,'選項 C'],['D',4,'選項 D'],['major',3,'分類']];
  function rawField(x,f){return /^[ABCD]$/.test(f)?String(((x&&x.options)||{})[f]||''):String((x&&x[f])||'');}
  function normFields(x){
    if(!x._snf){x._snf={};MCQ_FIELDS.forEach(function(fd){x._snf[fd[0]]=N(rawField(x,fd[0]));});x._snf.meta=N((x.subject||'')+' '+(x.year||'')+'年');}
    return x._snf;
  }
  function scoreMcq(x,terms,phrase){
    var nf=normFields(x),score=0,matched=[],best=null,inStem=false;
    terms.forEach(function(t){
      var hit=null;
      MCQ_FIELDS.forEach(function(fd){if(nf[fd[0]].indexOf(t)>=0&&(!hit||fd[1]>hit[1]))hit=fd;});
      if(!hit&&nf.meta.indexOf(t)>=0)hit=['meta',2,''];
      if(!hit)return;
      matched.push(t);score+=hit[1];
      if(hit[0]==='q')inStem=true;
      else if(hit[0]!=='meta'&&(!best||hit[1]>best[1]))best=hit;
    });
    if(!best&&inStem)best=MCQ_FIELDS[0];
    if(phrase&&terms.length>1&&nf.q.indexOf(phrase)>=0)score+=15;
    if(matched.length&&matched.length===terms.length)score+=20;
    return {score:score,matched:matched,hit:best};
  }
  function bankRows(){try{return Array.isArray(ALL)?ALL:[];}catch(_e){return [];}}
  function searchMcq(q){
    var terms=queryTerms(q),res={full:[],partial:[],terms:terms};
    if(!terms.length)return res;
    var phrase=N(toTrad(q));
    bankRows().forEach(function(x){
      try{if(typeof swsiSourceHeld==='function'&&swsiSourceHeld(x))return;}catch(_e){}
      var s=scoreMcq(x,terms,phrase);if(!s.matched.length)return;
      var rec={x:x,score:s.score,matched:s.matched,hit:s.hit,missing:terms.filter(function(t){return s.matched.indexOf(t)<0;})};
      (s.matched.length===terms.length?res.full:res.partial).push(rec);
    });
    function byScore(a,b){return b.score-a.score||yearNum(b.x.year)-yearNum(a.x.year);}
    res.full.sort(byScore);
    res.partial.sort(function(a,b){return b.matched.length-a.matched.length||byScore(a,b);});
    return res;
  }
  var HL_GAP='[\\s　（）()《》〈〉「」『』【】·・,，.。:：;；/\\\\_-]*';
  function hlRegex(terms){
    var parts=terms.slice().sort(function(a,b){return b.length-a.length;}).map(function(t){
      return Array.from(t).map(function(c){return c.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}).join(HL_GAP);
    }).filter(Boolean);
    return parts.length?new RegExp('('+parts.join('|')+')','gi'):null;
  }
  // Escape, then wrap matched words; optional window around the first match.
  function hl(text,terms,width){
    var s=String(text||'').replace(/\s+/g,' ').trim(),re=hlRegex(terms||[]);
    if(width&&s.length>width){
      var at=-1;if(re){re.lastIndex=0;var m=re.exec(s);if(m)at=m.index;}
      var from=at<0?0:Math.max(0,at-Math.floor(width/3));
      s=(from>0?'…':'')+s.slice(from,from+width)+(from+width<s.length?'…':'');
    }
    if(!re)return H(s);
    var out='',last=0,mm;re.lastIndex=0;
    while((mm=re.exec(s))){if(!mm[0]){re.lastIndex++;continue;}out+=H(s.slice(last,mm.index))+'<mark class="swsi-k-hl">'+H(mm[0])+'</mark>';last=mm.index+mm[0].length;}
    return out+H(s.slice(last));
  }
  if(typeof mcqBlob==='function'){
    // Keep the legacy searchAll consistent: it also sees option text.
    mcqBlob=function(x){
      if(x._sbo==null)x._sbo=((x.q||'')+' '+(x.topic||'')+' '+(x.major||'')+' '+(x.keywords||'')+' '+(x.mistake||'')+' '+(x.law||'')+' '+(x.subject||'')+' '+(x.year||'')+' '+[0,1,2,3].map(function(i){return rawField(x,'ABCD'.charAt(i));}).join(' ')).toLowerCase();
      return x._sbo;
    };
  }

  function smartSearch(query){
    var q=String(query||'').trim();
    var out={mcq:[],theories:[],laws:[],essays:[]};
    if(!q)return out;
    var variants=[q];
    if(!/\s/.test(q)){
      var al=ALIASES[q]||ALIASES[q.toLowerCase()]||[];
      al.forEach(function(x){if(!variants.includes(x))variants.push(x);});
    }
    variants.forEach(function(v){
      var r=typeof searchAll==='function'?searchAll(toTrad(v)):{mcq:[],theories:[],laws:[],essays:[]};
      (r.theories||[]).forEach(function(x){uniqPush(out.theories,x,function(z){return z.n;});});
      (r.laws||[]).forEach(function(x){uniqPush(out.laws,x,function(z){return z.n;});});
      (r.essays||[]).forEach(function(x){uniqPush(out.essays,x,function(z){return z.id;});});
    });
    // MCQ: ranked engine; aliases add their own full matches.
    var info={},partial=[];
    variants.forEach(function(v,vi){
      var m=searchMcq(v);
      m.full.forEach(function(rec){var o=info[rec.x.id];if(!o||o.partial||rec.score>o.score){rec.partial=false;rec.terms=m.terms;info[rec.x.id]=rec;}});
      if(vi===0)partial=m.partial;
    });
    out.mcq=Object.keys(info).map(function(k){return info[k];}).sort(function(a,b){return b.score-a.score||yearNum(b.x.year)-yearNum(a.x.year);}).map(function(rec){return rec.x;});
    out.mcqPartial=false;
    if(!out.mcq.length&&partial.length){
      partial.forEach(function(rec){rec.partial=true;rec.terms=queryTerms(q);info[rec.x.id]=rec;});
      out.mcq=partial.map(function(rec){return rec.x;});out.mcqPartial=true;
    }
    out.mcqInfo=info;out.terms=queryTerms(q);
    var nq=N(toTrad(q));
    function scoreName(x){var n=N(x||'');if(!nq)return 0;if(n===nq)return 50;if(n.indexOf(nq)>=0)return 30;if(nq.indexOf(n)>=0)return 20;return 0;}
    out.theories.sort(function(a,b){return scoreName(b.n)-scoreName(a.n);});
    out.laws.sort(function(a,b){return scoreName(b.n)-scoreName(a.n);});
    out.essays.sort(function(a,b){var sa=(N(a.topic).indexOf(nq)>=0?10:0);var sb=(N(b.topic).indexOf(nq)>=0?10:0);return sb-sa||yearNum(b.year)-yearNum(a.year);});
    return out;
  }

  if(typeof searchQuizMcq==='function'){
    searchQuizMcq=function(){
      var r=smartSearch(searchQ);if(!r.mcq.length)return;
      var ids=new Set(r.mcq.map(function(x){return x.id;}));
      startQuiz(function(x){return ids.has(x.id);});
    };
  }
  window.swsiKnowledgeSearch=function(q){
    try{searchQ=String(q||'');}catch(_e){window.searchQ=String(q||'');}
    try{go('search');}catch(_e){try{view='search';render();}catch(_x){}}
  };
  window.swsiFillKnowledgeSearch=function(encoded){
    var q='';try{q=decodeURIComponent(encoded||'');}catch(_e){q=encoded||'';}
    var box=document.getElementById('searchbox');
    if(box){box.value=q;box.focus();}
    if(typeof doSearch==='function')doSearch(q);
  };

  openTheory=function(name){
    var idx=-1;try{idx=THEORIES.findIndex(function(t){return t.n===name;});}catch(_e){}
    try{theoryQ='';theoryOpen=idx>=0?idx:null;}catch(_e){}
    go('theories');
    setTimeout(function(){var open=document.querySelector('#app .ecard.open');if(open)open.scrollIntoView({block:'start'});},60);
  };
  openLawCard=function(name){
    var idx=-1;try{idx=LAWS.findIndex(function(l){return l.n===name;});}catch(_e){}
    try{lawQ='';lawOpen=idx>=0?idx:null;}catch(_e){}
    go('laws');
    setTimeout(function(){var open=document.querySelector('#app .ecard.open');if(open)open.scrollIntoView({block:'start'});},60);
  };
  window.swsiOpenTheoryEncoded=function(x){try{openTheory(decodeURIComponent(x));}catch(_e){}};
  window.swsiOpenLawEncoded=function(x){try{openLawCard(decodeURIComponent(x));}catch(_e){}};
  window.swsiOpenEssayEncoded=function(id,subj){try{openEssayCard(decodeURIComponent(id),decodeURIComponent(subj));}catch(_e){}};
  window.swsiStudyOneEncoded=function(id){try{studyOne(decodeURIComponent(id));}catch(_e){}};

  renderSearch=function(){
    app.innerHTML='<div class="swsi-k-search-shell">'+
      '<input id="searchbox" class="swsi-k-searchbox" value="'+H(searchQ||'')+'" oninput="doSearch(this.value)" placeholder="查考點、理論、法規、選擇題、申論…" autocomplete="off" aria-label="搜尋國考知識">'+
      '<div id="search-results"></div></div>';
    doSearch(searchQ||'');
    setTimeout(function(){var el=document.getElementById('searchbox');if(el){var v=el.value;el.focus();el.setSelectionRange(v.length,v.length);}},40);
  };

  doSearch=function(val){
    try{searchQ=val;}catch(_e){}
    var box=document.getElementById('search-results');if(!box)return;
    var q=String(val||'').trim();
    if(!q){
      box.innerHTML='<div class="swsi-k-empty"><b style="color:var(--ink)">查一個你正在讀的東西。</b><br>平台會把辭典、法規、選擇題和申論排成同一條路，不用自己在四個頁面來回找。'+
        '<div class="swsi-k-examples">'+['Erikson','增強權能','社會救助法','保護令','依附'].map(function(x){return '<button type="button" onclick="swsiFillKnowledgeSearch(\''+E(x)+'\')">'+H(x)+'</button>';}).join('')+'</div></div>';
      return;
    }
    var r=smartSearch(q),terms=r.terms||queryTerms(q);
    var total=r.mcq.length+r.essays.length+r.theories.length+r.laws.length;
    if(!total){
      box.innerHTML='<div class="swsi-k-empty">找不到符合「<b style="color:var(--ink)">'+H(q)+'</b>」的內容。可以把詞拆短一點，例如「兒少 保護」改成「兒少」。</div>';
      return;
    }
    var h='<section class="swsi-k-path"><b>查「'+H(q)+'」的完整考法</b><span>先理解概念與法規，再看題目怎麼問，最後直接練。</span><div class="swsi-k-counts">'+
      (r.theories.length?'<i>理論 '+r.theories.length+'</i>':'')+(r.laws.length?'<i>法規 '+r.laws.length+'</i>':'')+(r.mcq.length?'<i>選擇 '+r.mcq.length+(r.mcqPartial?'（部分符合）':'')+'</i>':'')+(r.essays.length?'<i>申論／練習 '+r.essays.length+'</i>':'')+'</div></section>';

    h+='<section class="swsi-k-sec"><div class="swsi-k-sec-h"><b>1　先理解</b><span>平台整理，不冒充官方題目</span></div>';
    if(r.theories.length||r.laws.length){
      r.theories.slice(0,5).forEach(function(t){h+='<button class="swsi-k-card" onclick="swsiOpenTheoryEncoded(\''+E(t.n)+'\')"><div class="type">核心理論</div><div class="name">'+hl(t.n,terms)+'</div><div class="desc">'+hl(t.c,terms,72)+'</div></button>';});
      r.laws.slice(0,5).forEach(function(l){h+='<button class="swsi-k-card law" onclick="swsiOpenLawEncoded(\''+E(l.n)+'\')"><div class="type">重點法規</div><div class="name">'+hl(l.n,terms)+'</div><div class="desc">'+hl(l.c||l.p,terms,72)+'</div></button>';});
    }else h+='<div class="swsi-k-muted">這個詞目前沒有獨立的理論／法規卡，可以直接從歷屆題目的問法反推考點。</div>';
    h+='</section>';

    h+='<section class="swsi-k-sec"><div class="swsi-k-sec-h"><b>2　看選擇題怎麼考</b><span>'+r.mcq.length+' 題</span></div>';
    if(r.mcq.length){
      if(r.mcqPartial)h+='<div class="swsi-k-partial">沒有題目同時包含所有搜尋詞，下面是<b>部分符合</b>的題目，符合越多的排越前面。</div>';
      h+='<button class="swsi-k-action" onclick="searchQuizMcq()">直接練這 '+r.mcq.length+' 題</button>';
      r.mcq.slice(0,8).forEach(function(x){
        var rec=(r.mcqInfo||{})[x.id]||{},hit=rec.hit;
        h+='<div class="swsi-k-question" onclick="swsiStudyOneEncoded(\''+E(x.id)+'\')"><div class="q">'+hl(x.q,terms,76)+'</div>'+
          (hit&&hit[0]!=='q'?'<div class="hit"><span>'+H(hit[2])+'</span>'+hl(rawField(x,hit[0]),terms,48)+'</div>':'')+
          (rec.partial&&rec.missing&&rec.missing.length?'<div class="meta">部分符合 · 沒有「'+H(rec.missing.join('、'))+'」</div>':'')+
          '<div class="meta">'+H(x.subject||'')+' · '+H(x.year||'')+' 年 · '+H(x.topic||x.major||'')+'</div></div>';
      });
      if(r.mcq.length>8)h+='<div class="swsi-k-more">還有 '+(r.mcq.length-8)+' 題；上面的按鈕會把全部符合題目排成一組。</div>';
    }else h+='<div class="swsi-k-muted">目前沒有搜尋到直接命中的選擇題。</div>';
    h+='</section>';

    h+='<section class="swsi-k-sec"><div class="swsi-k-sec-h"><b>3　看申論怎麼出</b><span>'+r.essays.length+' 題</span></div>';
    if(r.essays.length){
      r.essays.slice(0,8).forEach(function(e){var kind=e.qtype||'申論題';h+='<div class="swsi-k-question" onclick="swsiOpenEssayEncoded(\''+E(e.id)+'\',\''+E(e.subject||'全部科目')+'\')"><div class="q">'+hl(e.q,terms,82)+'</div><div class="meta">'+H(kind)+' · '+H(e.subject||'')+(e.year?' · '+H(e.year)+' 年':'')+(e.topic?' · '+H(e.topic):'')+'</div></div>';});
      if(r.essays.length>8)h+='<div class="swsi-k-more">先列前 8 題；縮短或增加搜尋詞可以再聚焦。</div>';
    }else h+='<div class="swsi-k-muted">目前沒有搜尋到直接相關的申論題。</div>';
    h+='</section>';
    box.innerHTML=h;
  };

  function theoryRelatedLaws(t){
    var es=[];try{es=theoryEssays(t)||[];}catch(_e){}
    var names=[];es.forEach(function(e){A(e.laws).forEach(function(x){if(x&&!names.includes(x))names.push(x);});});
    var found=[];
    names.forEach(function(name){
      var nn=N(name), hit=null;
      try{hit=LAWS.find(function(l){var ln=N(l.n);return ln===nn||ln.indexOf(nn)>=0||nn.indexOf(ln)>=0;});}catch(_e){}
      if(hit&&!found.some(function(x){return x.n===hit.n;}))found.push(hit);
    });
    return found.slice(0,5);
  }

  knowledgeNetHTML=function(t,gi){
    var es=[];try{es=theoryEssays(t)||[];}catch(_e){}
    var mc=0;try{mc=theoryMcqCount(t)||0;}catch(_e){}
    var laws=theoryRelatedLaws(t);
    var h='<div class="swsi-k-net"><div class="swsi-k-net-title">從理論接到考題</div>'+
      '<button class="swsi-k-search-all" onclick="event.stopPropagation();swsiKnowledgeSearch(\''+H(t.n).replace(/'/g,'&#39;')+'\')">搜尋「'+H(t.n)+'」全部考法</button>';
    if(mc)h+='<button class="swsi-k-action" onclick="event.stopPropagation();quizTheory('+gi+')">練這個理論的選擇題（'+mc+' 題）</button>';
    if(laws.length){
      h+='<div class="swsi-k-related-label">申論資料裡常一起出現的法規</div><div class="swsi-k-related">';
      laws.forEach(function(l){h+='<button type="button" onclick="event.stopPropagation();swsiOpenLawEncoded(\''+E(l.n)+'\')">'+H(l.n)+'</button>';});
      h+='</div>';
    }
    if(es.length){
      h+='<div class="swsi-k-related-label">相關申論／練習題（'+es.length+'）</div>';
      es.slice(0,6).forEach(function(e){h+='<div class="swsi-k-question" onclick="event.stopPropagation();swsiOpenEssayEncoded(\''+E(e.id)+'\',\''+E(e.subject||'全部科目')+'\')"><div class="q">'+H(sn(e.topic||e.q,58))+'</div><div class="meta">'+H(e.qtype||'申論題')+(e.year?' · '+H(e.year)+' 年':'')+' · '+H(e.subject||'')+'</div></div>';});
      if(es.length>6)h+='<div class="swsi-k-more">還有 '+(es.length-6)+' 題，可用上方「搜尋全部考法」繼續看。</div>';
    }
    if(!mc&&!es.length)h+='<div class="swsi-k-muted">目前還沒有建立到考題的直接連結；可以用「搜尋全部考法」從題目文字繼續找。</div>';
    return h+'</div>';
  };

  function lawShortName(l){return N(l&&l.n).replace(/(施行細則|條例|辦法|規則|法)$/,'');}
  function lawMcqScore(q,l){
    // A profession name or generic keyword is not evidence of a law question.
    // Only the full law title in the examination text qualifies for this practice set.
    var blob=N([q.q].concat(['A','B','C','D'].map(function(k){return q.options&&q.options[k]||'';})).join(' ')),full=N(l&&l.n);
    return full&&blob.indexOf(full)>=0?10:0;
  }
  function lawMcqs(l){
    var list=[];try{list=ALL.filter(function(q){return lawMcqScore(q,l)>=2;});}catch(_e){}
    return list.sort(function(a,b){return lawMcqScore(b,l)-lawMcqScore(a,l)||yearNum(b.year)-yearNum(a.year);});
  }
  function lawEssayScore(e,l){
    var explicit=N(A(e.laws).join(' ')),full=N(l.n),short=lawShortName(l),score=0;
    if(full&&explicit.indexOf(full)>=0)score+=12;
    else if(short.length>=4&&explicit.indexOf(short)>=0)score+=7;
    var blob=N((e.q||'')+' '+(e.topic||'')+' '+A(e.keywords).join(' ')+' '+explicit);
    A(l.k).forEach(function(k){var nk=N(k);if(nk.length>=3&&blob.indexOf(nk)>=0)score++;});
    return score;
  }
  function lawEssays(l){
    var list=[];try{list=ESSAYS.filter(function(e){return lawEssayScore(e,l)>=2;});}catch(_e){}
    return list.sort(function(a,b){return lawEssayScore(b,l)-lawEssayScore(a,l)||yearNum(b.year)-yearNum(a.year);});
  }
  function lawRelatedTheories(l){
    var counts={};lawEssays(l).forEach(function(e){A(e.theories).forEach(function(x){if(x)counts[x]=(counts[x]||0)+1;});});
    var names=Object.entries(counts).sort(function(a,b){return b[1]-a[1];}).map(function(x){return x[0];});
    var found=[];
    names.forEach(function(name){var nn=N(name),hit=null;try{hit=THEORIES.find(function(t){var tn=N(t.n);return tn===nn||tn.indexOf(nn)>=0||nn.indexOf(tn)>=0;});}catch(_e){}if(hit&&!found.some(function(x){return x.n===hit.n;}))found.push(hit);});
    return found.slice(0,5);
  }
  window.swsiQuizLaw=function(gi){
    var l=null;try{l=LAWS[gi];}catch(_e){}if(!l)return;
    var ids=new Set(lawMcqs(l).map(function(q){return q.id;}));
    if(!ids.size)return;
    startQuiz(function(q){return ids.has(q.id);},0);
  };

  var LAW_STUDY_PRIORITY_URL='auto/law_study_priority.json';
  var lawStudyPriorityPromise=null;
  var lawStudyPriorityCache=null;
  function validLawStudyPriority(x){
    if(!x||x.schema_version!==1||!x.scope||!Array.isArray(x.laws))return false;
    if(Number(x.scope.recent_end_year)-Number(x.scope.recent_start_year)!==4)return false;
    return x.laws.every(function(l){
      return l&&typeof l.law_name==='string'&&Number.isFinite(Number(l.all_linked_question_count))&&Number.isFinite(Number(l.recent_five_year_question_count))&&Array.isArray(l.question_ids)&&Number(l.all_linked_question_count)===new Set(l.question_ids).size;
    });
  }
  function loadLawStudyPriority(){
    if(lawStudyPriorityCache)return Promise.resolve(lawStudyPriorityCache);
    if(lawStudyPriorityPromise)return lawStudyPriorityPromise;
    lawStudyPriorityPromise=fetch(LAW_STUDY_PRIORITY_URL,{credentials:'same-origin',cache:'no-cache'}).then(function(r){
      if(!r.ok)throw new Error('HTTP '+r.status);
      return r.json();
    }).then(function(x){
      if(!validLawStudyPriority(x))throw new Error('invalid law study priority snapshot');
      lawStudyPriorityCache=x;
      return x;
    }).catch(function(e){
      console.warn('law study priority unavailable',e);
      lawStudyPriorityPromise=null;
      return null;
    });
    return lawStudyPriorityPromise;
  }
  function lawStudyPriorityHTML(snapshot,law){
    var scope=snapshot.scope||{},recent=Number(law.recent_five_year_question_count)||0,all=Number(law.all_linked_question_count)||0;
    var recentLabel=String(scope.recent_label||('近五年（'+scope.recent_start_year+'–'+scope.recent_end_year+'）'));
    var allLabel=String(scope.first_exam_year||'')+'–'+String(scope.latest_exam_year||'')+' 全歷屆';
    var exams=Array.isArray(law.recent_exam_codes)?law.recent_exam_codes:[],ids=Array.isArray(law.question_ids)?law.question_ids:[];
    var h='<div class="swsi-law-study-priority" style="margin:0 0 14px;padding:12px 13px;border:1px solid var(--line);border-radius:12px;background:var(--paper2,#f7f7f4)"><div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap"><div><b style="font-size:12.5px;color:var(--ink)">歷屆題目足跡</b><div style="font-size:10.8px;line-height:1.55;color:var(--ink-soft);margin-top:2px">只算題庫中明確連結到這部法規的題目</div></div><span style="font-size:10.5px;border:1px solid var(--line);background:#fff;border-radius:999px;padding:3px 8px;color:var(--pine-deep);font-weight:700">可追溯題號</span></div>'+
      '<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:9px"><div style="padding:8px 9px;border-radius:9px;background:#fff"><div style="font-size:10.5px;color:var(--ink-soft)">'+H(recentLabel)+'</div><div style="font-size:18px;font-weight:900;color:var(--pine-deep);margin-top:2px">'+recent+' <span style="font-size:11px">題</span></div></div><div style="padding:8px 9px;border-radius:9px;background:#fff"><div style="font-size:10.5px;color:var(--ink-soft)">'+H(allLabel)+'</div><div style="font-size:18px;font-weight:900;color:var(--ink);margin-top:2px">'+all+' <span style="font-size:11px">題</span></div></div></div>'+
      '<div style="font-size:10.8px;line-height:1.6;color:var(--ink-soft);margin-top:7px">'+(exams.length?'近五年出現考次：'+H(exams.join('、')):'近五年沒有找到明確法規連結題；不代表未來不會考。')+'</div>'+
      '<details style="margin-top:7px"><summary style="cursor:pointer;font-size:11px;font-weight:800;color:var(--pine-deep)">查看全部可追溯題號（'+all+'）</summary><div style="margin-top:6px;line-height:1.75">'+ids.map(function(id){return '<code style="display:inline-block;margin:2px 4px 2px 0;padding:3px 6px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--pine-deep);font-size:10.5px">'+H(id)+'</code>';}).join('')+'</div></details>'+
      '<div style="font-size:10.2px;line-height:1.6;color:var(--ink-soft);margin-top:8px">'+H(snapshot.student_boundary||'')+'</div></div>';
    return h;
  }
  function decorateLawStudyPriority(){
    var slot=document.querySelector('#app .swsi-law-study-priority-slot[data-law-name]');
    if(!slot)return;
    var name=slot.getAttribute('data-law-name')||'';
    loadLawStudyPriority().then(function(snapshot){
      if(!snapshot)return;
      var current=document.querySelector('#app .swsi-law-study-priority-slot[data-law-name]');
      if(!current||current.getAttribute('data-law-name')!==name||current.querySelector('.swsi-law-study-priority'))return;
      var law=null;
      for(var i=0;i<snapshot.laws.length;i+=1){if(snapshot.laws[i]&&snapshot.laws[i].law_name===name){law=snapshot.laws[i];break;}}
      if(law)current.innerHTML=lawStudyPriorityHTML(snapshot,law);
    });
  }

  function lawKnowledgeNetHTML(l,gi){
    var mc=lawMcqs(l),es=lawEssays(l),ths=lawRelatedTheories(l);
    var h='<div class="swsi-law-study-priority-slot" data-law-name="'+H(l.n)+'"></div><div class="swsi-k-net"><div class="swsi-k-net-title">從法規接到考題</div>'+
      '<button class="swsi-k-search-all" onclick="event.stopPropagation();swsiKnowledgeSearch(\''+H(l.n).replace(/'/g,'&#39;')+'\')">搜尋「'+H(l.n)+'」全部考法</button>';
    if(mc.length)h+='<button class="swsi-k-action" onclick="event.stopPropagation();swsiQuizLaw('+gi+')">練這部法規的選擇題（'+mc.length+' 題）</button>';
    if(ths.length){
      h+='<div class="swsi-k-related-label">申論資料裡常一起出現的理論</div><div class="swsi-k-related">';
      ths.forEach(function(t){h+='<button type="button" onclick="event.stopPropagation();swsiOpenTheoryEncoded(\''+E(t.n)+'\')">'+H(t.n)+'</button>';});
      h+='</div>';
    }
    if(es.length){
      h+='<div class="swsi-k-related-label">相關申論／練習題（'+es.length+'）</div>';
      es.slice(0,6).forEach(function(e){h+='<div class="swsi-k-question" onclick="event.stopPropagation();swsiOpenEssayEncoded(\''+E(e.id)+'\',\''+E(e.subject||'全部科目')+'\')"><div class="q">'+H(sn(e.topic||e.q,58))+'</div><div class="meta">'+H(e.qtype||'申論題')+(e.year?' · '+H(e.year)+' 年':'')+' · '+H(e.subject||'')+'</div></div>';});
      if(es.length>6)h+='<div class="swsi-k-more">還有 '+(es.length-6)+' 題，可用搜尋繼續縮小。</div>';
    }
    if(!mc.length&&!es.length)h+='<div class="swsi-k-muted">目前還沒有建立到考題的直接連結；可用「搜尋全部考法」從題目文字繼續找。</div>';
    return h+'</div>';
  }

  renderLaws=function(){
    var q=String(lawQ||'').trim(),list=LAWS;
    if(q)list=LAWS.filter(function(l){return (l.n+' '+l.d+' '+l.p+' '+l.c+' '+l.a+' '+(l.u||'')+' '+A(l.k).join(' ')).toLowerCase().indexOf(q.toLowerCase())>=0;});
    var order=[],byD={};
    list.forEach(function(l){if(!byD[l.d]){byD[l.d]=[];order.push(l.d);}byD[l.d].push(l);});
    var groups=order.map(function(d){
      var cards=byD[d].map(function(l){
        var gi=LAWS.indexOf(l),open=lawOpen===gi;
        return '<div class="ecard '+(open?'open':'')+'"><div class="ehead" onclick="toggleLaw('+gi+')"><div class="etopic">'+H(l.n)+'</div>'+(open?'':'<div class="ehint">點開看重點與歷屆考法 ›</div>')+'</div>'+
          (open?'<div class="ebodywrap" onclick="event.stopPropagation()"><div style="margin-bottom:13px;line-height:1.7"><b style="color:var(--ink-soft)">管什麼</b><br>'+H(l.p)+'</div><div style="margin-bottom:13px;line-height:1.7"><b style="color:var(--pine)">核心重點</b><br>'+H(l.c)+'</div><div style="margin-bottom:13px;line-height:1.7"><b style="color:var(--gold)">申論怎麼用</b><br>'+H(l.a)+'</div>'+
          (l.u?'<div style="margin-bottom:13px;line-height:1.7;background:var(--wrong-bg);padding:10px 12px;border-radius:10px"><b style="color:var(--wrong)">⚠ 修法動態</b><br>'+H(l.u)+'</div>':'')+
          '<div class="kws">'+A(l.k).map(function(k){return '<span class="kw">'+H(k)+'</span>';}).join('')+'</div>'+lawKnowledgeNetHTML(l,gi)+'<button class="ecollapse" onclick="toggleLaw('+gi+')">▲ 收合</button></div>':'')+'</div>';
      }).join('');
      return '<div class="subj-pill" style="margin-top:16px">'+H(d)+'</div>'+cards;
    }).join('');
    app.innerHTML='<div class="swsi-k-pagelead"><button onclick="go(\'topics\')">‹ 回學習工具</button><button onclick="swsiKnowledgeSearch(\'\')">⌕ 全域搜尋</button></div><div class="section-h">重點法規速查</div><div class="section-s">先抓法規重點，再直接看它曾經怎麼出現在選擇題與申論。<br><span style="color:var(--ink-soft);font-size:12px">※ 法規會修正，應試前仍以全國法規資料庫最新版為準。</span></div><input placeholder="搜尋法規或關鍵詞…" value="'+H(lawQ||'')+'" oninput="lawQ=this.value;lawOpen=null;render()" style="width:100%;box-sizing:border-box;padding:11px 14px;border:1px solid var(--line);border-radius:12px;font-family:inherit;font-size:14px;margin-bottom:4px;background:#fff;color:var(--ink)">'+(list.length?groups:'<div class="empty" style="padding:40px 0"><p>找不到符合的法規。</p></div>');
    decorateLawStudyPriority();
  };

  var oldRenderTheories=renderTheories;
  renderTheories=function(){
    oldRenderTheories();
    var back=document.querySelector('#app > button');
    if(back&&/回考點/.test(back.textContent||''))back.textContent='‹ 回學習工具';
    if(!document.querySelector('#app .swsi-k-pagelead')){
      var lead=document.createElement('div');lead.className='swsi-k-pagelead';lead.innerHTML='<span></span><button type="button" onclick="swsiKnowledgeSearch(\'\')">⌕ 全域搜尋</button>';
      var first=document.querySelector('#app .section-h');if(first)first.insertAdjacentElement('beforebegin',lead);
    }
    var sub=document.querySelector('#app .section-s');if(sub)sub.innerHTML='先理解理論，再直接看它和哪些歷屆選擇題、申論與法規連在一起。';
  };

  /* SWSI RELATED LEARNING START 2026-11-07
     Explicit metadata and exact topic matching only. No model-inferred links,
     no edits to official question/answer data, and no extra network requests. */
  function swsiRelatedTheory(item){
    var label=String(item&&item.topic||'');
    var keys=A(item&&item.keywords),explicit=A(item&&item.theories);
    var candidates=[];
    try{candidates=THEORIES.filter(function(t){
      var name=N(t&&t.n);
      return name.length>=4 && (
        explicit.some(function(v){return N(v)===name;}) ||
        (label&&N(label).indexOf(name)>=0) ||
        keys.some(function(v){return N(v)===name;})
      );
    });}catch(_e){}
    candidates.sort(function(a,b){return N(b.n).length-N(a.n).length;});
    return candidates[0]||null;
  }
  function swsiRelatedLaw(item){
    var tags=[String(item&&item.law||'')].concat(A(item&&item.laws));
    var candidates=[];
    try{candidates=LAWS.filter(function(l){
      var name=N(l&&l.n);
      return name.length>=4&&tags.some(function(v){
        var tag=N(v);
        return tag===name || (tag.length>name.length&&tag.indexOf(name)>=0);
      });
    });}catch(_e){}
    candidates.sort(function(a,b){return N(b.n).length-N(a.n).length;});
    return candidates[0]||null;
  }
  function swsiRelatedTopic(item){
    var topic=N(item&&item.topic||'');
    return topic.length>=6?topic:'';
  }
  function swsiRelatedMcqs(item,theory,law){
    var topic=swsiRelatedTopic(item),key=String(item&&item.id||'');
    var tn=theory?N(theory.n):'',ln=law?N(law.n):'',rows=[];
    try{rows=ALL.filter(function(q){
      if(!q||String(q.id||'')===key)return false;
      if(ln&&N(q.law||'').indexOf(ln)>=0)return true;
      if(tn&&((N(q.topic||'').indexOf(tn)>=0)||
        A(q.keywords).some(function(v){return N(v)===tn;})))return true;
      return topic&&N(q.topic||'')===topic;
    });}catch(_e){}
    return rows.sort(function(a,b){return yearNum(b.year)-yearNum(a.year);}).slice(0,60);
  }
  function swsiRelatedEssays(item,theory,law){
    var topic=swsiRelatedTopic(item),key=String(item&&item.id||'');
    var tn=theory?N(theory.n):'',ln=law?N(law.n):'',rows=[];
    try{rows=ESSAYS.filter(function(e){
      if(!e||String(e.id||'')===key)return false;
      if(tn&&A(e.theories).some(function(v){return N(v)===tn;}))return true;
      if(ln&&A(e.laws).some(function(v){return N(v)===ln;}))return true;
      return topic&&N(e.topic||'')===topic;
    });}catch(_e){}
    return rows.sort(function(a,b){return yearNum(b.year)-yearNum(a.year);}).slice(0,30);
  }
  function swsiRelatedElement(item,kind){
    var theory=swsiRelatedTheory(item),law=swsiRelatedLaw(item);
    var mcqs=swsiRelatedMcqs(item,theory,law),essays=swsiRelatedEssays(item,theory,law);
    if(!theory&&!law&&!mcqs.length&&!essays.length)return null;
    var panel=document.createElement('details');
    panel.className='swsi-related-learning';
    panel.setAttribute('aria-label','延伸學習與相關考題');
    var summary=document.createElement('summary');
    summary.textContent='延伸學習 · 相關考題';
    panel.appendChild(summary);
    var body=document.createElement('div');body.className='swsi-related-body';
    panel.appendChild(body);
    function addButton(label,action){
      var btn=document.createElement('button');btn.type='button';
      btn.textContent=label;btn.addEventListener('click',function(ev){ev.stopPropagation();action();});
      body.appendChild(btn);
    }
    if(theory)addButton('看理論：'+theory.n,function(){window.swsiOpenTheoryEncoded(E(theory.n));});
    if(law)addButton('看法規：'+law.n,function(){window.swsiOpenLawEncoded(E(law.n));});
    if(mcqs.length){
      addButton('練同考點選擇題（'+mcqs.length+' 題）',function(){
        if(kind==='mcq'){
          try{
            if(typeof confirm==='function'&&!confirm('將開始另一組題目，離開目前的練習，確定繼續？'))return;
          }catch(_e){return;}
        }
        var ids=new Set(mcqs.map(function(x){return x.id;}));
        if(typeof startQuiz==='function')startQuiz(function(q){return ids.has(q.id);},10);
      });
    }
    essays.slice(0,2).forEach(function(e){
      addButton('相關申論：'+sn(e.topic||e.q||'申論題',34),function(){
        window.swsiOpenEssayEncoded(E(e.id),E(e.subject||'全部科目'));
      });
    });
    var foot=document.createElement('p');foot.className='swsi-related-note';
    foot.textContent='依題目標籤自動關聯，供延伸學習；不代表考選部認定的考點或已完成法規核對。';
    body.appendChild(foot);
    return panel;
  }
  function swsiDecorateLearningConnections(){
    try{
      var exp=document.querySelector('#app .qcard .exp');
      if(exp&&!exp.querySelector(':scope > .swsi-related-learning')){
        var item=null;
        try{if(typeof answered!=='undefined'&&answered&&typeof queue!=='undefined')item=queue[idx];}catch(_e){}
        if(item){
          var box=swsiRelatedElement(item,'mcq');
          if(box){
            var anchor=exp.querySelector(':scope > .swsi-answer-trust, :scope > .swsi-explanation-more, :scope > .btn');
            if(anchor)exp.insertBefore(box,anchor);else exp.appendChild(box);
          }
        }
      }
      if(typeof view==='undefined'||view!=='essay'||typeof openEssay==='undefined'||!openEssay)return;
      var essay=null;
      try{essay=ESSAYS.find(function(e){return e&&e.id===openEssay;});}catch(_e){}
      if(!essay)return;
      var body=document.querySelector('#app .ecard.open .ebodywrap');
      if(!body||body.querySelector(':scope > .swsi-related-learning'))return;
      var extra=swsiRelatedElement(essay,'essay');
      if(extra)body.appendChild(extra);
    }catch(err){console.warn('[SWSI] related learning unavailable',err);}
  }
  document.addEventListener('swsi:learning-surface-ready',swsiDecorateLearningConnections);
  /* SWSI RELATED LEARNING END */

})();
