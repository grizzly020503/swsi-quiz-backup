{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wandering-wave-4418",
  "main": "cloudflare/wandering-wave-4418/entry.js",
  "compatibility_date": "2026-08-25",
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    // Production static assets are materialized under ./cdn; touching this
    // config intentionally forces Cloudflare Git integration to rebuild them.
    // 2026-10-02: force production rebuild for shard revision 5c4acad4299dbae1caee + Qwen 3.8 legacy-client compatibility.
    // 2026-11-26: force production rebuild for shard revision 54410073a28c81b5f9cb (legal-status batches 7-35, #633).
    "directory": "./cdn"
  },
  "d1_databases": [
    {
      "binding": "AI_QUOTA_DB",
      "database_name": "swsi-ai-quota",
      "database_id": "163a1766-885f-449a-b5da-7b72aa3c5ab2"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "AI_IP_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
